# Copy to .env. Never commit .env. On Cloud Run these come from env vars and Secret Manager.

# Gemini on Vertex AI: no key. Run `gcloud auth application-default login` and
# `gcloud auth application-default set-quota-project <PROJECT_ID>` once.
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Judge + patch writer (a different provider from the attackers). Read it from Secret Manager:
#   gcloud secrets versions access latest --secret=openai-api-key
OPENAI_API_KEY=

# Langfuse (optional locally; tracing is a no-op without keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Models (LiteLLM ids). Defaults shown.
# ATTACK_MODEL=vertex_ai/gemini-3.5-flash-lite
# VICTIM_MODEL=vertex_ai/gemini-3.5-flash-lite
# JUDGE_MODEL=gpt-6.1-sol
# PATCH_MODEL=gpt-6.1-sol

# 1 = canned answers, no credentials (tests, CI, UI work)
GAUNTLET_FAKE_LLM=1
# FAKE_LLM_DELAY_SECONDS=0

# Caps. Defaults shown.
# MAX_PARALLEL_CALLS=6
# RUNS_PER_ATTACK=3
# QUICK_BUDGET_S=240

# External agents whose owners agreed to be tested (comma-separated URL prefixes)
TARGET_ALLOWLIST=
